# Kie.ai API key — get yours at https://kie.ai/api-key
KIE_API_KEY=

# Video resolution passed to Kie.ai Seedance 2.0 Fast (accepted values: 480p, 720p)
KIE_VIDEO_RESOLUTION=480p

# ── Native-ending test mode ────────────────────────────────────────────────────
# Set to "true" to test whether Kie Seedance can end the video natively on the
# Got Jesus end card image (bypasses FFmpeg finalization pipeline).
# Set to "false" or remove to use the normal 7-sec + FFmpeg end card pipeline.
KIE_NATIVE_ENDING_TEST=false

# Official Got Jesus end card hosted on Supabase (used as last_frame_url in test mode)
GOT_JESUS_ENDCARD_SUPABASE_URL=https://phhczohqidgrvcmszets.supabase.co/storage/v1/object/public/GOT%20JESUS/image/gotjesus-endcard.png

# Blotato API key — get yours at https://blotato.com
BLOTATO_API_KEY=

# Blotato platform account IDs — add the ones you want to post to
BLOTATO_INSTAGRAM_ACCOUNT_ID=
BLOTATO_YOUTUBE_ACCOUNT_ID=
BLOTATO_TIKTOK_ACCOUNT_ID=

# Supabase — project URL and service role key (not the anon key)
# The service role key is required for server-side Storage uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket name for final videos (must exist and be public)
SUPABASE_VIDEO_BUCKET=gotjesus-videos
