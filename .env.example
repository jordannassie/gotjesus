# ── Kie.ai ─────────────────────────────────────────────────────────────────────
# API key — get yours at https://kie.ai/api-key
KIE_API_KEY=

# Video resolution passed to Kie.ai Seedance 2.0 Fast (accepted values: 480p, 720p)
KIE_VIDEO_RESOLUTION=480p

# Official Got Jesus end card hosted on Supabase (used as last_frame_url for branded ending)
GOT_JESUS_ENDCARD_SUPABASE_URL=https://phhczohqidgrvcmszets.supabase.co/storage/v1/object/public/GOT%20JESUS/image/gotjesus-endcard.png

# ── Blotato ─────────────────────────────────────────────────────────────────────
# API key — get yours at https://blotato.com
BLOTATO_API_KEY=

# Platform account IDs — add the ones you want to post to
BLOTATO_INSTAGRAM_ACCOUNT_ID=
BLOTATO_YOUTUBE_ACCOUNT_ID=
BLOTATO_TIKTOK_ACCOUNT_ID=

# ── Supabase ─────────────────────────────────────────────────────────────────────
# Project URL and service role key (NOT the anon key — service role is required
# for server-side Storage uploads and DB writes that bypass RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage configuration
# Bucket: the exact bucket name as shown in Supabase (note: "GOT JESUS" with a space)
# Folder: the subfolder path inside that bucket
SUPABASE_VIDEO_BUCKET=GOT JESUS
SUPABASE_VIDEO_FOLDER=gotjesus-videos

# Example public video URL that results from the above config:
# https://<project>.supabase.co/storage/v1/object/public/GOT%20JESUS/gotjesus-videos/<id>.mp4
